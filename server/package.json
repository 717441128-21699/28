{
  "name": "cheyipai-server",
  "version": "1.0.0",
  "description": "车易拍二手车交易平台后端服务（PostgreSQL 版）",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "node app.js",
    "db:init": "node scripts/init-db.js",
    "db:seed": "node seed.js",
    "setup": "npm install && node scripts/init-db.js",
    "db:start-win": "net start postgresql-x64-16",
    "db:stop-win": "net stop postgresql-x64-16"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dayjs": "^1.11.10",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.21.0",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5"
  }
}
